{
  "name": "spud-screeps-bot",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "zig build lint && oxlint --type-check --type-aware",
    "build": "rolldown -c",
    "fmt": "zig fmt . --exclude zig-pkg && oxfmt",
    "fmt:check": "zig fmt . --exclude zig-pkg --check && oxfmt --check",
    "push": "rolldown -c --environment DEST:",
    "test": "node --run fmt:check && node --run lint && node --run test:unit",
    "test:unit": "zig build test --summary all && vitest run --typecheck",
    "watch": "rolldown -cw"
  },
  "devDependencies": {
    "@types/lodash": "3.10.2",
    "@types/node": "^26.6.2",
    "@types/screeps": "npm:@screepts/types",
    "oxfmt": ">=0.41.0 <2.0.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.0",
    "rolldown": "^1.0.0-rc.9",
    "rollup-plugin-screeps-world": "npm:@screepts/rollup-plugin-screeps-world@^1.0.0",
    "source-map-js": "^1.2.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "screeps_bot": true
}
